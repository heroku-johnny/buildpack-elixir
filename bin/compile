#!/usr/bin/env bash

set -e -o pipefail

buildpack_path=$(cd "$(dirname "$(dirname "$0")")"; pwd)
build_path=$(cd "$1" && pwd)
cache_path=$(cd "$2" && pwd)
env_path=$(cd "$3" && pwd)

source "${buildpack_path}/lib/output.sh"
source "${buildpack_path}/lib/paths.sh"
source "${buildpack_path}/lib/stack.sh"
source "${buildpack_path}/lib/config.sh"
source "${buildpack_path}/lib/erlang.sh"
source "${buildpack_path}/lib/elixir.sh"
source "${buildpack_path}/lib/cache.sh"

mkdir -p "$(platform_tools_dir)"

export_env_vars "${env_path}"
export_mix_env
export_mix_home
export_hex_home
load_config

prepare_cache

download_erlang
install_erlang

download_elixir
install_elixir
