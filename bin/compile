#!/usr/bin/env bash
# shellcheck disable=SC1091  # dynamic source paths can't be followed statically

set -e -o pipefail

buildpack_path=$(
  cd "$(dirname "$(dirname "$0")")"
  pwd
)
# shellcheck disable=SC2034  # consumed by sourced lib scripts
build_path=$(cd "$1" && pwd)
# shellcheck disable=SC2034  # consumed by sourced lib scripts
cache_path=$(cd "$2" && pwd)
env_path=$(cd "$3" && pwd)

source "${buildpack_path}/lib/output.sh"
source "${buildpack_path}/lib/paths.sh"
source "${buildpack_path}/lib/stack.sh"
source "${buildpack_path}/lib/config.sh"
source "${buildpack_path}/lib/erlang.sh"
source "${buildpack_path}/lib/elixir.sh"
source "${buildpack_path}/lib/cache.sh"
source "${buildpack_path}/lib/mix.sh"
source "${buildpack_path}/lib/hooks.sh"
source "${buildpack_path}/lib/app.sh"
source "${buildpack_path}/lib/profile.sh"

mkdir -p "$(platform_tools_dir)"

export_env_vars "${env_path}"
export_mix_env "prod"
export_mix_home
export_hex_home
load_config

prepare_cache

download_erlang
install_erlang

download_elixir
install_elixir

restore_mix_cache
install_hex
install_rebar

restore_app_cache
hook_pre_fetch_dependencies
fetch_dependencies

hook_pre_compile
compile_app
hook_post_compile

build_release
backup_app_cache
backup_mix_cache

write_profile_d
write_export
