# Heroku buildpack for Elixir — default configuration
#
# These defaults are applied before your app's elixir_buildpack.config.
# Your app config takes precedence for any values you set.

# Erlang/OTP version — must be set explicitly in your app's config.
# Supported versions: https://builds.hex.pm/builds/otp/ubuntu-22.04/builds.txt
#                     https://builds.hex.pm/builds/otp/ubuntu-24.04/builds.txt
#                     https://builds.hex.pm/builds/otp/ubuntu-26.04/builds.txt
# Note: heroku-26 requires OTP 26 or later.
erlang_version=

# Elixir version — must be set explicitly in your app's config.
# Use a release version (e.g. 1.18.3) or a branch (e.g. branch main).
# Supported releases: https://builds.hex.pm/builds/elixir/builds.txt
elixir_version=

# Set to true to force a full rebuild on every deploy.
always_rebuild=false

# Runtime path where the app will run. Matches Heroku's /app.
runtime_path=/app

# Set to true to run `mix release` instead of leaving process management
# to the Procfile.
release=false

# Lifecycle hooks — shell commands run at specific points in the build.
# Leave blank to skip.
hook_pre_fetch_dependencies=
hook_pre_compile=
hook_compile=
hook_post_compile=
